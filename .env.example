# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (from https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Groq LLM Model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Tourist Safety (Phase 5) ──
# Telegram user IDs of the safety desk / tourism police (comma-separated).
# They receive SOS + high-severity alerts and can use /dashboard, /addzone, /whereis.
# Tip: send /dashboard to the bot to see your own ID.
ADMIN_IDS=

# Minutes without a location update (during an active trip) before a safety check-in
SAFETY_INACTIVITY_MIN=30
# Minutes to wait for a check-in reply before alerting guardians + safety desk
SAFETY_ESCALATE_MIN=15

# ── Next-gen: Web Command Center & public portal (Phase 6) ──
# Built-in web server (no extra install). Set WEB_ENABLED=0 to turn it off.
WEB_ENABLED=1
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Secret for the live command-center map. If empty, a random one is generated at
# each start and sent to ADMIN_IDS on Telegram (also printed in the log).
DASHBOARD_TOKEN=
# Public address of the portal, used in Digital ID QR codes.
# Use your ngrok / server URL so phones can open it, e.g. https://safety.example.org
PUBLIC_BASE_URL=http://localhost:8080

# ── Zero-cost guards ──
# Daily caps that keep every service inside its free tier. When a cap is reached the
# feature switches to its free offline mode until 00:00 UTC (safety features never stop).
# Groq is free without a payment card; never add a card and it can never charge you.
AI_DAILY_LIMIT=300
WEATHER_DAILY_LIMIT=5000
ROUTING_DAILY_LIMIT=500
PLACES_DAILY_LIMIT=2000
