# Travel Buddy configuration. Copy to .env and fill in. Check with:  python scripts/preflight.py

# ---- Required -------------------------------------------------------------
# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram user IDs of the safety desk / tourism police (comma-separated).
# They receive SOS + high-severity alerts and can use /dashboard, /addzone, /whereis
# and the web command center. Tip: send /dashboard to the bot to see your own ID.
ADMIN_IDS=

# ---- AI (optional, free) --------------------------------------------------
# Groq key from https://console.groq.com/ (free, no card). Empty = free offline mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Safety monitor -------------------------------------------------------
# Minutes without a location update (during an active trip) before a safety check-in
SAFETY_INACTIVITY_MIN=30
# Minutes to wait for a check-in reply before alerting guardians + safety desk
SAFETY_ESCALATE_MIN=15

# ---- Web portal & command center -----------------------------------------
WEB_ENABLED=1
# 127.0.0.1 behind a reverse proxy / tunnel (recommended); 0.0.0.0 inside Docker
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 1 = if the port is busy, try the next free one (laptop). 0 = fail instead (servers).
WEB_PORT_FALLBACK=1
# Public HTTPS address of the portal. Used in Digital ID QR codes, magic sign-in links and
# for Secure cookies. Phones need https (browsers block location on plain http).
PUBLIC_BASE_URL=http://localhost:8080
# 1 when running behind Caddy / nginx / Cloudflare Tunnel, so rate limits see real visitor IPs
TRUST_PROXY=0
# Secret for the command-center link. Empty = a random one is generated once, stored in the
# database, and sent to ADMIN_IDS on Telegram at start-up.
DASHBOARD_TOKEN=

# ---- Storage & logs -------------------------------------------------------
# SQLite file (default: travel_bot.db in the project folder)
DATABASE_PATH=
# Rotating log file (5 x 2 MB). Set empty to log to the console only.
LOG_FILE=travel_buddy.log
LOG_LEVEL=INFO

# ---- Zero-cost guards -----------------------------------------------------
# Daily caps that keep every service inside its free tier. When a cap is reached the
# feature switches to its free offline mode until 00:00 UTC (safety features never stop).
AI_DAILY_LIMIT=300
WEATHER_DAILY_LIMIT=5000
ROUTING_DAILY_LIMIT=500
PLACES_DAILY_LIMIT=2000

# ---- Demo only ------------------------------------------------------------
# 1 = load 5 sample geo-fence zones into an EMPTY database. Keep 0 in production and add
# real zones with /addzone or the Desk tab of the command center.
SEED_STARTER_ZONES=0
